@@ -24,6 +24,23 @@ source scripts/baitly-deployment-images.sh
 baitly_prepare_deployment_images || exit 1
 DC="docker compose -f docker-compose.prod.yml --env-file .env --env-file .env.baitly-images"
 
+# PostgreSQL is the only local-only image; application services must still pull their exact GHCR tags.
+pull_baitly_images() {
+  local services=("$@")
+  if [ "${#services[@]}" -eq 0 ]; then
+    while IFS= read -r entry; do services+=("$entry"); done < <($DC config --services)
+  fi
+  local remote_services=()
+  local service
+  for service in "${services[@]}"; do
+    if [ "$service" != "postgres" ]; then remote_services+=("$service"); fi
+  done
+  if [ "${#remote_services[@]}" -gt 0 ]; then
+    $DC pull "${remote_services[@]}"
+  fi
+}
+
+
