--- /dev/null
+++ b/postgres/Dockerfile
@@ -0,0 +1,5 @@
+# Baitly: PostgreSQL major version and existing pgvector volumes stay compatible.
+FROM pgvector/pgvector:pg15
+RUN apt-get update \
+    && apt-get install -y --no-install-recommends postgresql-15-postgis-3 postgresql-15-postgis-3-scripts \
+    && rm -rf /var/lib/apt/lists/*
--- /dev/null
+++ b/.github/workflows/ci-baitly-postgres.yml
@@ -0,0 +1,28 @@
+name: Baitly PostgreSQL spatial image
+on:
+  pull_request:
+    paths: ['postgres/Dockerfile', '.github/workflows/ci-baitly-postgres.yml']
+  push:
+    branches: [main]
+    paths: ['postgres/Dockerfile', '.github/workflows/ci-baitly-postgres.yml']
+permissions:
+  contents: read
+jobs:
+  extensions:
+    runs-on: ubuntu-latest
+    timeout-minutes: 15
+    steps:
+      - uses: actions/checkout@v4
+      - name: Build PostgreSQL 15 with pgvector and PostGIS
+        run: docker build -t baitly-postgres:test postgres
+      - name: Verify extensions on an ephemeral database
+        run: |
+          docker run -d --name baitly-postgres-smoke -e POSTGRES_HOST_AUTH_METHOD=trust baitly-postgres:test postgres -c shared_preload_libraries=pg_stat_statements
+          for attempt in $(seq 1 60); do
+            if docker exec baitly-postgres-smoke pg_isready -U postgres; then break; fi
+            sleep 2
+          done
+          docker exec baitly-postgres-smoke psql -U postgres -v ON_ERROR_STOP=1 -c 'CREATE EXTENSION vector; CREATE EXTENSION postgis; CREATE EXTENSION pg_stat_statements; SELECT PostGIS_Version(); SELECT count(*) FROM pg_stat_statements;'
+      - name: Remove ephemeral test database
+        if: always()
+        run: docker rm -f baitly-postgres-smoke || true
