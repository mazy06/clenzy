# Copier vers .env.baitly-instagram.local à la racine du dépôt Baitly.
# Le fichier privé est ignoré par Git ; ne jamais committer le secret.
BAITLY_INSTAGRAM_APP_ID=29087565920904248
BAITLY_INSTAGRAM_APP_SECRET=
# En local, utiliser un retour HTTPS vers le backend local, enregistré dans Meta.
# Le retour de production ci-dessous ne permet pas de tester le serveur local.
BAITLY_INSTAGRAM_REDIRECT_URI=https://app.baitly.fr/api/public/baitly-catalog/instagram/callback
BAITLY_INSTAGRAM_API_VERSION=v25.0
