# TypeScript build info
*.tsbuildinfo

# Environment variables (secrets - ne jamais commiter)
.env
.env.*
!.env.example
.env.local
.env.development.local
.env.test.local
.env.production.local

# IDE
.vscode/
.idea/
*.swp
*.swo

# Claude Code worktrees (locaux, gérés par Claude Code, ne pas commiter)
.claude/worktrees/

# OS
.DS_Store
Thumbs.db

