    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <!-- 3.5.16 (2026-08) : correctifs seuls, meme branche mineure. Traite d'un
             coup les CVE >= 7 remontees par dependency-check sur tomcat-embed-core
             (9.8), spring-core (9.8), spring-security-core et
             spring-security-oauth2-resource-server (8.1), postgresql (8.2) et
             jackson-databind (8.1) — toutes gerees par le BOM. -->
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>com.clenzy</groupId>
    <artifactId>clenzy-platform</artifactId>
    <version>1.0.0</version>
    <name>Clenzy Platform</name>
    <description>Plateforme de gestion des services Airbnb - Clenzy</description>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <spring-cloud.version>2024.0.0</spring-cloud.version>
        <aws.sdk.version>2.23.0</aws.sdk.version>
        <serverless.version>1.0.0</serverless.version>
        <testcontainers.version>1.19.3</testcontainers.version>
        <mockito.version>5.14.2</mockito.version>
        <byte-buddy.version>1.15.11</byte-buddy.version>
        <!--
            Override la version Liquibase par defaut de Spring Boot 3.2 (4.24.0)
            pour s'aligner sur la version utilisee par les workflows d'infra
            (DB Status + Liquibase Unlock sur clenzy-infra).
            Sans cet alignement, les checksums calcules par 4.24.0 differeraient
            de ceux stockes dans databasechangelog (calcules par 4.29.2) -> mismatch
            au boot Liquibase -> echec d'application avec "column already exists"
            sur les changesets pre-baseline (incident 0111 / Option C, mai 2026).
            Liquibase s'applique automatiquement au boot Spring Boot dans tous les
            environnements (spring.liquibase.enabled=true).
        -->
        <liquibase.version>4.29.2</liquibase.version>
        <!--
            Incrément 1 (overrides tomcat.version/postgresql.version pour fermer
            CVE-2025-24813 / CVE-2024-1597 sur Boot 3.2) RETIRÉ : Spring Boot 3.5.x
            manage déjà des versions patchées (tomcat ≥ 10.1.4x, postgresql ≥ 42.7.x).
            Vérifié post-build via dependency:list.
        -->

        <!--
            Correctifs de sécurité au-dessus du BOM (2026-08-15). 3.5.16 est le
            DERNIER de la branche 3.5 : plus aucun correctif n'arrivera par le
            parent, la suite est Spring Boot 4.0 (Jakarta EE 11 + Spring
            Framework 7), une migration à part entière. En attendant, on relève
            ici les dépendances que dependency-check fait échouer (CVSS ≥ 7),
            toutes DANS leur branche majeure : aucun changement d'API attendu.

            Retirer un override dès que le parent gère une version au moins
            égale — sinon on gèlerait la dépendance sous le BOM.
        -->
        <!-- 10.1.57 : 9 CVE publiees fin aout 2026, dont CVE-2026-65905 et
             CVE-2026-65637 (9.8), CVE-2026-65182 et CVE-2026-68525 (9.1).
             10.1.59 est le dernier de la branche (pas de 10.1.58). Rester en
             10.1.x : Tomcat 11 est Servlet 6.1 / Jakarta EE 11, incompatible
             avec Spring Boot 3.5. -->
        <tomcat.version>10.1.59</tomcat.version>
        <!-- 4.1.135 : 13 CVE, dont CVE-2026-56820 (9.1) -->
        <netty.version>4.1.137.Final</netty.version>
        <!-- 42.7.11 : CVE-2026-54291 (8.2) -->
        <postgresql.version>42.7.13</postgresql.version>
        <!-- 1.9.25 : CVE-2026-53914 (9.8). Transitif via minio → okhttp ;
             la stdlib Kotlin est rétro-compatible, okhttp 4.12 tourne dessus. -->
        <kotlin.version>2.4.10</kotlin.version>
        <!-- 2.24.3 : CVE-2026-34479, corrigee en 2.25.4. Attention au score —
             dependency-check AFFICHE le CVSS v4.0 (6.9) mais compare le v3.1
             (7.5) au seuil : la ligne semblait sous le seuil et bloquait bel et
             bien le build. -->
        <log4j2.version>2.25.5</log4j2.version>
        <!-- httpcore5 / httpclient5 : plus d'override, ils ne sont plus dans
             l'arbre depuis le retrait de firebase-admin, qui les tirait seul. -->
    </properties>

