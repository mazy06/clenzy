# Dedicated IoT database; never use the PMS database or a production database for tests.
BAITLY_IOT_DATABASE_URL=jdbc:postgresql://127.0.0.1:5432/baitly_iot
BAITLY_IOT_DATABASE_USER=baitly_iot
BAITLY_IOT_DATABASE_PASSWORD=
# Generate a random secret with at least 32 characters. No fallback credential exists.
BAITLY_IOT_SERVICE_TOKEN=
BAITLY_IOT_BIND_ADDRESS=127.0.0.1
BAITLY_IOT_PORT=8095
# Separate private connector. PMS uses this port; devices and simulator use 8095.
BAITLY_IOT_INTERNAL_ADDRESS=127.0.0.1
BAITLY_IOT_INTERNAL_PORT=8096
# Required for deployment: restricted runtime role, pre-applied migrations, no migration secrets.
# SPRING_PROFILES_ACTIVE=hardened

# Optional MQTT/mTLS receiver. Private broker listener, never a third-party broker.
BAITLY_IOT_MQTT_ENABLED=false
BAITLY_IOT_MQTT_HOST=localhost
BAITLY_IOT_MQTT_PORT=8884
BAITLY_IOT_MQTT_CA_FILE=
BAITLY_IOT_MQTT_CLIENT_STORE=
BAITLY_IOT_MQTT_CLIENT_STORE_PASSWORD=
